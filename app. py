# 4. App Form Evaluation Architecture
@app.route("/", methods=["GET", "POST"])
def index():
    prediction_text = None
    sqft = 1200
    bhk = 2
    bathrooms = 2
    selected_city = 'Kochi'
    selected_property_type = 'Apartment'

    if request.method == "POST":
        try:
            sqft = int(request.form['sqft'])
            bhk = int(request.form['bhk'])
            bathrooms = int(request.form['bathrooms'])
            selected_city = request.form['city']
            selected_property_type = request.form['property_type']

            input_data = {col: 0 for col in feature_columns}
            input_data['sqft'] = sqft
            input_data['bhk'] = bhk
            input_data['bathrooms'] = bathrooms

            city_column_key = f"city_{selected_city}"
            if city_column_key in input_data:
                input_data[city_column_key] = 1

            prop_column_key = f"property_type_{selected_property_type}"
            if prop_column_key in input_data:
                input_data[prop_column_key] = 1

            input_df = pd.DataFrame([input_data])[feature_columns]
            predicted_raw = model.predict(input_df.values)
            prediction_text = format_indian_currency(max(0, predicted_raw[0]))
        except Exception as e:
            print(f"Error handling prediction submission: {e}")

    return render_template_string(
        HTML_TEMPLATE,
        cities_list=cities_pool,
        property_types_list=property_types_pool,
        selected_city=selected_city,
        selected_property_type=selected_property_type,
        prediction_text=prediction_text,
        sqft=sqft,
        bhk=bhk,
        bathrooms=bathrooms,
    )

if __name__ == "__main__":
    app.run(host="127.0.0.1", port=5000, debug=True)
