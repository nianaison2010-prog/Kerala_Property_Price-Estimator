import numpy as np
import pandas as pd
from flask import Flask, render_template_string, request
from sklearn.linear_model import LinearRegression

# 1. Initialize Flask App
app = Flask(__name__)

# 2. Build a Localised Kerala Synthetic Dataset with Area (Sq. Ft.)
np.random.seed(42)
num_samples = 500

# Base structural features
dummy_bhk = np.random.randint(1, 5, size=num_samples)  # 1 to 4 BHK
dummy_bathrooms = dummy_bhk + np.random.choice([0, 1], size=num_samples, p=[0.7, 0.3])

# Generate realistic square footage based on BHK size
dummy_sqft = (dummy_bhk * 700) + np.random.randint(-200, 600, size=num_samples)
dummy_sqft = np.clip(dummy_sqft, 450, 4500)

# Categorical options
cities_pool = ['Kochi', 'Thiruvananthapuram', 'Kozhikode', 'Thrissur', 'Kottayam']
property_types_pool = ['Apartment', 'Independent Villa', 'Traditional House']

dummy_cities = np.random.choice(cities_pool, size=num_samples)
dummy_prop_types = np.random.choice(property_types_pool, size=num_samples)

# Setup pricing multipliers per location and type
city_multipliers = {'Kochi': 1.45, 'Thiruvananthapuram': 1.25, 'Kozhikode': 1.05, 'Thrissur': 0.95, 'Kottayam': 0.80}
type_multipliers = {'Apartment': 1.00, 'Independent Villa': 1.50, 'Traditional House': 1.20}

# Calculate baseline price structure: Base price + (Sq Ft * Rate) + Layout Premium
base_price = 1000000
rate_per_sqft = 3500  

dummy_prices = []
for i in range(num_samples):
    structural_value = base_price + (dummy_sqft[i] * rate_per_sqft) + (dummy_bhk[i] * 200000) + (dummy_bathrooms[i] * 100000)
    multiplier = city_multipliers[dummy_cities[i]] * type_multipliers[dummy_prop_types[i]]
    final_price = (structural_value * multiplier) + np.random.randint(-300000, 500000)
    dummy_prices.append(final_price)

# Constructing DataFrame
df = pd.DataFrame({
    'sqft': dummy_sqft,
    'bhk': dummy_bhk,
    'bathrooms': dummy_bathrooms,
    'city': dummy_cities,
    'property_type': dummy_prop_types,
    'price_inr': dummy_prices
})

# One-Hot Encode categorical columns
df_encoded = pd.get_dummies(df, columns=['city', 'property_type'], drop_first=False)

# Separate inputs (X) and target output (y)
X = df_encoded.drop(columns=['price_inr'])
y = df_encoded['price_inr']

feature_columns = X.columns.tolist()

# Train the multi-variable model
model = LinearRegression()
model.fit(X.values, y.values)

# Indian Currency Comma Formatting Function (Lakhs and Crores)
def format_indian_currency(number):
    s = str(int(round(number)))
    if len(s) <= 3:
        return s
    last_three = s[-3:]
    remaining = s[:-3]
    remaining_fmt = ""
    while len(remaining) > 2:
        remaining_fmt = "," + remaining[-2:] + remaining_fmt
        remaining = remaining[:-2]
    if remaining:
        remaining_fmt = remaining + remaining_fmt
    return remaining_fmt + "," + last_three

